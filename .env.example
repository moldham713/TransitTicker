# Copy to .env (git-ignored) for local `docker compose up` to pick these up
# automatically. See infra/variables.tf's google_client_id for where the
# value comes from and what to configure on the credential itself - add
# http://localhost:5001 as an Authorized JavaScript origin on it too, or
# the Google sign-in button will fail locally with an origin-mismatch error.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional - only matters if you want session cookies to survive a backend
# container restart during local testing. The default in docker-compose.yml
# is fine otherwise; this isn't a real secret in dev either way.
# SESSION_SECRET_KEY=some-random-local-value
